<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:allowNativeHeapPointerTagging="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:extractNativeLibs="true"
        android:fullBackupContent="@xml/backup_rules"
        android:hasCode="true"
        android:icon="@mipmap/ic_launcher_vs"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_vs_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:name="dev.dioxus.main.MainActivity"
            android:configChanges="orientation|screenLayout|screenSize|keyboardHidden|fontScale|uiMode"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="android.app.lib_name"
                android:value="main" />
            <meta-data
                android:name="android.app.func_name"
                android:value="ANativeActivity_onCreate" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider
            android:name="dev.dioxus.main.ExportFileProvider"
            android:authorities="fr.variete_saveurs.devis_factures.exports"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
