<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Self-update from within the app (issue 35). Declared here, but still
         granted by hand once in « Installer des applications inconnues » —
         the settings screen sends her there rather than let the install fail
         with no explanation. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- One 20 ms pulse when a number is spent, and nothing else. `navigator.
         vibrate` is a silent no-op without this, so the acknowledgement in
         `ui/components/issue_sheet.rs` would simply never happen. Normal
         permission: no runtime prompt, no access to anything. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:allowNativeHeapPointerTagging="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:extractNativeLibs="true"
        android:fullBackupContent="@xml/backup_rules"
        android:hasCode="true"
        android:icon="@mipmap/ic_launcher_vs"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_vs_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:name="dev.dioxus.main.MainActivity"
            android:configChanges="orientation|screenLayout|screenSize|keyboardHidden|fontScale|uiMode"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="android.app.lib_name"
                android:value="main" />
            <meta-data
                android:name="android.app.func_name"
                android:value="ANativeActivity_onCreate" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider
            android:name="dev.dioxus.main.ExportFileProvider"
            android:authorities="fr.variete_saveurs.devis_factures.exports"
            android:exported="false"
            android:grantUriPermissions="true" />
        <provider
            android:name="dev.dioxus.main.UpdateFileProvider"
            android:authorities="fr.variete_saveurs.devis_factures.updates"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
